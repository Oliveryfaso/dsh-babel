{
  "name": "dsh-babel",
  "version": "1.0.0",
  "type": "module",
  "description": "Use MCP servers, plugins and slash commands from other AI coding harnesses inside the DeepSeek Harness — by reading their existing configuration instead of asking their authors to port, and reporting honestly what runs, what needs a key, and what cannot run.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "interop",
    "claude-code",
    "codex",
    "plugin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-babel": "./bin/dsh-babel.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/normalize.test.mjs && node test/commands.test.mjs && node test/register.test.mjs && node test/secrets.test.mjs",
    "report": "node bin/dsh-babel.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0"
  }
}
